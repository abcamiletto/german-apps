<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.abcamiletto.wortschatz-deploy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/abcamiletto/german-apps/server/deploy/deploy.sh</string>
	</array>
	<key>UserName</key>
	<string>abcamiletto</string>
	<key>GroupName</key>
	<string>staff</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/abcamiletto</string>
		<key>UV_CACHE_DIR</key>
		<string>/Users/abcamiletto/Library/Caches/wortschatz-uv</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/Users/abcamiletto/Library/Logs/wortschatz-deploy.log</string>
