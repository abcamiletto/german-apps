<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.abcamiletto.wortschatz-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--no-dev</string>
        <string>uvicorn</string>
        <string>sync_server:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>43130</string>
        <string>--no-server-header</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/abcamiletto/german-apps/server</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>WORTSCHATZ_DB</key>
        <string>/Users/abcamiletto/Library/Application Support/Wortschatz/sync.db</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Users/abcamiletto/Library/Logs/wortschatz-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/abcamiletto/Library/Logs/wortschatz-sync.log</string>
</dict>
</plist>
